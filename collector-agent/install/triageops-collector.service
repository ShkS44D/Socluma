[Unit]
Description=TriageOps Telemetry Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=triageops-collector
Group=triageops-collector
WorkingDirectory=/opt/triageops-collector
EnvironmentFile=/etc/triageops-collector.env
ExecStart=/opt/triageops-collector/venv/bin/python main.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/triageops-collector

[Install]
WantedBy=multi-user.target
