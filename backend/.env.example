PROJECT_NAME=TriageOps
ENVIRONMENT=development

# Local development defaults
USE_SQLITE=true
USE_REDIS_MOCK=true
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","::1","testserver"]

# PostgreSQL mode
POSTGRES_SERVER=localhost
POSTGRES_USER=triageops
POSTGRES_PASSWORD=triageops_secret
POSTGRES_DB=triageops

# Redis mode
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_DEFAULT=200/minute
METRICS_ENABLED=true
METRICS_PATH=/metrics
WEBSOCKET_HEARTBEAT_SECONDS=30
SOAR_TASK_ALWAYS_EAGER=false

# Development secrets may be generated automatically when omitted.
# Production must provide strong values with at least 32 characters.
SECRET_KEY=
JWT_SECRET_KEY=
REFRESH_TOKEN_SECRET=
COLLECTOR_TOKEN_SECRET=

# Optional bootstrap admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional in development; required by production runtime validation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_REASONING_EFFORT=medium
AI_CONTEXT_MAX_BYTES=65536
AI_CONTEXT_MAX_ALERTS=20
AI_CONTEXT_MAX_EVENTS=30
AI_CONTEXT_MAX_ENTITIES=30
AI_CONTEXT_MAX_IOCS=20
AI_CONTEXT_MAX_EVIDENCE=40
AI_CONTEXT_MAX_NOTES=20
AI_CONTEXT_MAX_AUDIT_EVENTS=30
CORRELATION_WINDOW_MINUTES=15
CORRELATION_MIN_SCORE=45
CORRELATION_MIN_ALERTS=2
AI_CONVERSATION_HISTORY_LIMIT=12
AI_REQUEST_IDEMPOTENCY_TTL_SECONDS=86400
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
