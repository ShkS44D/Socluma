PROJECT_NAME=TriageOps
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
# Keep API docs enabled locally. Production validation requires false.
DOCS_ENABLED=true

# Local development defaults
USE_SQLITE=true
USE_REDIS_MOCK=true
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","::1","testserver"]

# PostgreSQL mode
POSTGRES_SERVER=localhost
POSTGRES_USER=triageops
POSTGRES_PASSWORD=triageops_secret
POSTGRES_DB=triageops

# Redis mode
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_DEFAULT=200/minute
METRICS_ENABLED=true
METRICS_PATH=/metrics
WEBSOCKET_HEARTBEAT_SECONDS=30
SOAR_TASK_ALWAYS_EAGER=false
# Days an owner can cancel a scheduled organization deletion (1-365).
ORGANIZATION_DELETION_COOLING_OFF_DAYS=30

# Development secrets may be generated automatically when omitted.
# Production must provide strong values with at least 32 characters.
SECRET_KEY=
JWT_SECRET_KEY=
REFRESH_TOKEN_SECRET=
COLLECTOR_TOKEN_SECRET=

# Audit integrity and encrypted-field key rings. Keep all keys outside the database.
# Dedicated production key rings are recommended. If omitted at version 1, the
# existing strong application secrets provide backward-compatible derived keys.
AUDIT_INTEGRITY_KEY=
AUDIT_INTEGRITY_KEY_VERSION=1
AUDIT_INTEGRITY_KEYS_JSON=
ENCRYPTION_CURRENT_KEY_VERSION=1
ENCRYPTION_KEYS_JSON=
AUDIT_RETENTION_MINIMUM_DAYS=90
AUDIT_RETENTION_MAXIMUM_DAYS=3650
AUDIT_ARCHIVE_DIRECTORY=./data/audit-archives
AUDIT_EXPORT_DIRECTORY=./data/audit-exports
AUDIT_EXPORT_EXPIRE_HOURS=24
AUDIT_ARTIFACT_ENCRYPTION_ENABLED=false

# Optional bootstrap admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Interactive account security
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_BCRYPT_ROUNDS=12
MFA_ISSUER=TriageOps
MFA_CHALLENGE_MINUTES=5
MFA_ENROLLMENT_MINUTES=10
MFA_FAILURE_LIMIT=5
MFA_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_MINUTES=30
SESSION_INACTIVITY_DAYS=7
SESSION_MAX_LIFETIME_DAYS=30
AUTH_RATE_LIMIT_MFA=5/minute
AUTH_RATE_LIMIT_RECOVERY=5/minute
AUTH_RATE_LIMIT_PASSWORD_RESET=3/hour
AUTH_RATE_LIMIT_VERIFICATION=3/hour
FRONTEND_PUBLIC_URL=http://localhost:3000
SECURE_COOKIE=false
COOKIE_SAMESITE=lax

# Authentication email. Capture is development/test only and must be false in production.
AUTH_EMAIL_FROM=security@triageops.local
AUTH_EMAIL_CAPTURE=true
AUTH_DEV_EXPOSE_TOKENS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional in development; required by production runtime validation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_REASONING_EFFORT=medium
AI_CONTEXT_MAX_BYTES=65536
AI_CONTEXT_MAX_ALERTS=20
AI_CONTEXT_MAX_EVENTS=30
AI_CONTEXT_MAX_ENTITIES=30
AI_CONTEXT_MAX_IOCS=20
AI_CONTEXT_MAX_EVIDENCE=40
AI_CONTEXT_MAX_NOTES=20
AI_CONTEXT_MAX_AUDIT_EVENTS=30
CORRELATION_WINDOW_MINUTES=15
CORRELATION_MIN_SCORE=45
CORRELATION_MIN_ALERTS=2
CORRELATION_ALLOW_REPEATED_ALERTS=false
AI_CONVERSATION_HISTORY_LIMIT=12
AI_REQUEST_IDEMPOTENCY_TTL_SECONDS=86400
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
# Phase 5 telemetry and collector controls
INGESTION_MAX_BATCH_EVENTS=500
INGESTION_MAX_EVENT_BYTES=262144
INGESTION_MAX_REQUEST_BYTES=10485760
INGESTION_MAX_RETRY_ATTEMPTS=5
INGESTION_DEAD_LETTER_RETENTION_DAYS=30
COLLECTOR_CREDENTIAL_LIFETIME_DAYS=365
COLLECTOR_CREDENTIAL_OVERLAP_MINUTES=15
COLLECTOR_ENROLLMENT_TOKEN_MINUTES=30
COLLECTOR_LATEST_VERSION=1.0.0
COLLECTOR_SUPPORTED_VERSIONS=["1.0.0"]
COLLECTOR_BLOCKED_VERSIONS=[]
TELEMETRY_IMPORT_MAX_BYTES=25000000
SYSLOG_UDP_ENABLED=false
SYSLOG_TCP_ENABLED=false
SYSLOG_TLS_ENABLED=false

# Phase 6 database-backed search and investigation workspace
SEARCH_DEFAULT_RANGE_HOURS=24
SEARCH_MAX_INTERACTIVE_DAYS=30
SEARCH_MAX_BACKGROUND_DAYS=365
SEARCH_MAX_QUERY_LENGTH=4000
SEARCH_MAX_CLAUSES=50
SEARCH_MAX_NESTING_DEPTH=8
SEARCH_MAX_WILDCARDS=5
SEARCH_MAX_LIST_SIZE=50
SEARCH_MAX_PAGE_SIZE=200
SEARCH_MAX_EXPORT_ROWS=100000
SEARCH_EXPORT_EXPIRE_HOURS=24
SEARCH_HISTORY_RETENTION_DAYS=90
SEARCH_MAX_SCHEDULES_PER_TENANT=100
SEARCH_AUTOCOMPLETE_LIMIT=20
ENTITY_GRAPH_MAX_DEPTH=3
ENTITY_GRAPH_MAX_NODES=200
ENTITY_GRAPH_MAX_EDGES=500
INVESTIGATION_ATTACHMENT_MAX_BYTES=10000000
INVESTIGATION_ALLOWED_ATTACHMENT_TYPES=["image/png","image/jpeg","application/pdf","text/plain","text/csv"]

# Phase 7 detection engineering limits
DETECTION_MAX_RULE_BYTES=262144
DETECTION_MAX_COMPLEXITY=100
DETECTION_MAX_BOOLEAN_CLAUSES=50
DETECTION_MAX_SEQUENCE_STEPS=10
DETECTION_MAX_GROUP_BY_FIELDS=5
DETECTION_MAX_AGGREGATION_CARDINALITY=10000
DETECTION_MIN_WINDOW_SECONDS=10
DETECTION_MAX_WINDOW_SECONDS=86400
DETECTION_MAX_REGEX_LENGTH=512
DETECTION_REGEX_TIMEOUT_MS=25
DETECTION_REGEX_MAX_INPUT_BYTES=8192
DETECTION_TEST_DATASET_MAX_EVENTS=1000
DETECTION_SIMULATION_MAX_DAYS=30
DETECTION_SIMULATION_MAX_EVENTS=100000
DETECTION_SIMULATION_MAX_RUNTIME_SECONDS=300
DETECTION_SIMULATION_EXPIRE_HOURS=24
DETECTION_REVIEW_EXPIRE_HOURS=72
DETECTION_REQUIRE_TWO_PERSON_APPROVAL=true
DETECTION_MAINTENANCE_MAX_HOURS=168
DETECTION_EXCEPTION_MAX_DAYS=365
DETECTION_STATE_RETENTION_HOURS=48
DETECTION_EXECUTION_TIMEOUT_MS=250
DETECTION_NOISE_ALERTS_PER_HOUR=100
DETECTION_CONTENT_PACK_MAX_BYTES=5000000
DETECTION_IMPORT_MAX_RULES=100

# Phase 7.5 IOC intelligence bounded defaults
IOC_DEFAULT_TTL_DAYS=90
IOC_MAX_TTL_DAYS=3650
IOC_EXPIRATION_BATCH_SIZE=500
IOC_PROVIDER_RETRY_LIMIT=3
IOC_PROVIDER_TIMEOUT_SECONDS=15
IOC_PROVIDER_CONCURRENCY=4
IOC_HUNT_MAX_DAYS=90
IOC_HUNT_MAX_EVENTS=100000
IOC_HUNT_MAX_RUNTIME_SECONDS=300
IOC_HUNT_RETENTION_HOURS=168
IOC_ACTIVE_CACHE_SECONDS=60
IOC_MAX_WATCHLIST_SIZE=100000
IOC_MAX_BULK_SIZE=5000
IOC_STIX_MAX_BYTES=10000000
IOC_STIX_MAX_OBJECTS=25000
IOC_TAXII_MAX_BYTES=10000000
IOC_TAXII_SYNC_MINUTES=60
IOC_MISP_MAX_BYTES=10000000
IOC_MISP_SYNC_MINUTES=60
IOC_SIGHTING_GROUPING_SECONDS=300
IOC_IMPORT_ARTIFACT_HOURS=24
IOC_REPORT_ARTIFACT_HOURS=24
TAXII_SYNC_ENABLED=false
MISP_SYNC_ENABLED=false

# Phase 7.6 IOC commercial completion
THREAT_SOURCE_REQUEST_TIMEOUT_SECONDS=15
THREAT_SOURCE_MAX_REDIRECTS=3
THREAT_SOURCE_MAX_RESPONSE_BYTES=10000000
THREAT_SOURCE_ALLOWED_DESTINATIONS=[]
THREAT_SOURCE_ALLOW_PRIVATE_DEVELOPMENT=false
TAXII_SYNC_MAX_PAGES=100
TAXII_SYNC_MAX_OBJECTS=25000
TAXII_SYNC_MAX_RUNTIME_SECONDS=300
MISP_SYNC_MAX_OBJECTS=25000
MISP_SYNC_MAX_RUNTIME_SECONDS=300
IOC_BULK_IMPORT_MAX_BYTES=25000000
IOC_BULK_IMPORT_MAX_ROWS=100000
IOC_BULK_ACTION_MAX_SIZE=5000
IOC_HUNT_MAX_CONCURRENCY=4
IOC_GRAPH_MAX_DEPTH=3
IOC_GRAPH_MAX_NODES=300
IOC_GRAPH_MAX_EDGES=750
IOC_REPORT_MAX_ROWS=100000
IOC_NOTIFICATION_COOLDOWN_SECONDS=900
IOC_RESPONSE_RECOMMENDATION_HOURS=24
THREAT_SYNC_JOB_RETENTION_DAYS=30
IOC_COMMERCIAL_ARTIFACT_DIRECTORY=./data/ioc-artifacts
